{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npx expo export --platform web --output-dir dist",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/worldcover/:path*",
      "destination": "https://esa-worldcover.s3.eu-central-1.amazonaws.com/:path*"
    },
    {
      "source": "/gaez/:path*",
      "destination": "https://storage.googleapis.com/fao-gismgr-gaez-v5-data/:path*"
    },
    {
      "source": "/nasadem/:path*",
      "destination": "https://nasademeuwest.blob.core.windows.net/nasadem-cog/:path*"
    },
    {
      "source": "/pc-sas/:path*",
      "destination": "https://planetarycomputer.microsoft.com/api/sas/:path*"
    },
    {
      "source": "/pc-data/:path*",
      "destination": "https://planetarycomputer.microsoft.com/api/data/:path*"
    },
    {
      "source": "/isric-maps/:path*",
      "destination": "https://maps.isric.org/:path*"
    },
    {
      "source": "/power/:path*",
      "destination": "https://power.larc.nasa.gov/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    },
    {
      "source": "/worldcover/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/gaez/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/nasadem/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/pc-sas/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/isric-maps/:path*",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=2592000"
        }
      ]
    },
    {
      "source": "/power/:path*",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=86400"
        }
      ]
    }
  ]
}
