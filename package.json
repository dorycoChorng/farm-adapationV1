  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:map": "node --test scripts/test-map.mjs",
    "typecheck": "tsc --noEmit",
    "build:map": "node scripts/build-map-html.mjs",
    "build:licenses": "node scripts/build-licenses.mjs dist",
    "postinstall": "node scripts/build-map-html.mjs",
    "test:web": "expo export --platform web --output-dir dist && node --test scripts/test-app-web.mjs",
    "test:all": "npm test && npm run test:map && npm run test:web",
    "build:geodata": "node scripts/build-geodata.mjs",
    "lint": "expo lint",
    "test:live": "LIVE_DATA=1 jest src/env/__tests__/live"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/scripts/"
