    "@types/pako": "^2.0.4",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/parser": "^8.71.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-import-resolver-typescript": "^3.10.1",
